# URL where Grafana sends alert webhooks.
# Phase 3 (testing): use https://webhook.site/your-test-id
# Phase 4 (live): leave unset — defaults to http://webhook-receiver:8080/alert (in-stack container)
# If running sp_oncall outside Docker, set to: http://<laptop-ip>:8080/alert
WEBHOOK_RECEIVER_URL=

# LangGraph API server for sp_oncall (Phase 4).
# The webhook-receiver container connects to this URL to trigger investigations.
# host.docker.internal resolves correctly on macOS Podman and Docker Desktop.
# On Linux or the VM: replace with the actual host IP (e.g. http://172.17.0.1:2024)
LANGGRAPH_API_URL=http://host.docker.internal:2024

# sp_oncall graph name (key in langgraph.json "graphs" block, default: "agent")
LANGGRAPH_ASSISTANT_ID=agent

# Loki URL for Grafana datasource.
# Split mode (primary): Alloy+Loki run on the VM, Grafana queries it remotely.
# Set before running `make up` on the laptop. Default: http://10.10.20.15:3100
LOKI_URL=http://10.10.20.15:3100

# Static IPs for gnp-stack containers on the XRd macvlan network (10.10.20.0/24).
# Only needed for `make up-vm` (full-VM mode).
# Must not conflict with XRd devices (101-108), VM host (15), or gateway (254).
ALLOY_MACVLAN_IP=10.10.20.11
GRAFANA_MACVLAN_IP=10.10.20.12
